DATABASE_URL=postgresql://postgres:postgres@db:5432/recoverai
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Keep false for the default demo. Set true only with Razorpay Test Mode credentials.
ENABLE_RAZORPAY_TEST_ACTIONS=false
# Keep false in production. Enable only for an explicitly isolated local demo.
ALLOW_SQLITE_FALLBACK=false
# Razorpay recommends signature verification on every webhook.
REQUIRE_WEBHOOK_SIGNATURE=true
WEBHOOK_MAX_AGE_SECONDS=300
LLM_PROVIDER=deterministic
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
MAX_RETRIES=3
MIN_CONFIDENCE_THRESHOLD=0.70
INTERVENTION_COST=5.0
MAX_CUSTOMER_CONTACTS=2
RETRY_DELAYS_HOURS=24,72,168
RESCUE_WINDOW_DAYS=30
CORS_ORIGINS=*
